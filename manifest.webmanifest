{
  "name": "Daily — personal dashboard",
  "short_name": "Daily",
  "description": "Weather, news, health, workouts, calendar and calorie tracking in one place.",
  "start_url": "./#home",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f3f4f8",
  "theme_color": "#6155f5",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log food", "url": "./#diet", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My workout", "url": "./#workout", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "./#calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
